# ==============================================================================
# OmniPost Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your preferences:
#   cp .env.example .env
#
# OmniPost is completely standalone and zero-agent. It reads your credentials
# from this file and communicates directly with your chosen LLM and platform APIs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider (Choose one: gemini, openai, anthropic, openrouter, ollama)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini (Default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Local Ollama / vLLM (Zero API Key, 100% Offline)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:latest

# ------------------------------------------------------------------------------
# 2. Platform Authentication
# ------------------------------------------------------------------------------
# Bluesky (API App Password created at bsky.app -> Settings -> App Passwords)
BSKY_IDENTIFIER=yourname.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# X / Twitter, LinkedIn, and Threads are automated via Chrome/Edge CDP session.
# No API keys or developer subscriptions required!
# Simply log into each platform in the automation window:
#   omnipost browser start

# ------------------------------------------------------------------------------
# 3. Optional Notification Webhooks
# ------------------------------------------------------------------------------
# Telegram Bot alerts for successful posts and health checks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
